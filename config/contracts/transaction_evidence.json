    "list": "[0-9]+(?:[.,][0-9]+)?\\s*(?:and\\b|or\\b|و|أو|او|[,،])\\s*[0-9]",
    "receiverIdentifierPrefix": "(?:account|wallet|حساب(?:ك|كم)?)\\s*"
  }
}
