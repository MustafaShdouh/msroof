{
  "version": "1.0.0",
  "scope": "Shared structural evidence for the detailed API; not learned weights or exhaustive language coverage",
  "number": "[0-9]+(?:[,'’][0-9]{3})*(?:[.,][0-9]+)?",
  "patterns": {
    "sentence": "(?<=[.!?؟;])\\s+|[\\r\\n]+|\\s+(?:but|however|لكن)\\s+",
    "completion": "\\b(?:debited|credited|withdrawn|deposited|refunded|paid)\\b|\\b(?:purchase|payment|transfer|transaction|withdrawal|deposit|refund|cashback)\\b[^!?;]{0,100}\\b(?:completed|successful|processed|received)\\b|\\b(?:completed|successful|processed)\\s+(?:card\\s+)?(?:purchase|payment|transfer|transaction|withdrawal|deposit|refund)\\b|(?:تم|تمت)\\s+(?:خصم|سحب|[إا]يداع|[إا]ضافة|تحويل|دفع|تسديد|شراء|استلام|قيد|[إا]رجاع)|استلمت\\s+(?:حوالة|مبلغ)|(?:تم|تمت)\\s+(?:تنفيذ\\s+)?(?:عملية\\s+)?(?:الشراء|الدفع|التحويل|السحب|الخصم|[إا]يداع|شراء)",
    "completionDenied": "\\b(?:not|never|not\\s+yet)\\s+(?:been\\s+)?(?:completed|debited|credited|paid|processed)\\b|\\b(?:will|may|would|could|can|to)\\s+(?:be\\s+)?(?:completed|debited|credited|paid|processed)\\b|لم\\s+(?:يتم|تتم)|لم\\s+(?:يخصم|تخصم)|سيتم|سوف\\s+يتم|\\b(?:if|when|once)\\b[^!?;]{0,100}\\b(?:completed|debited|credited|paid|processed)\\b",
    "outgoing": "\\b(?:purchase|payment|debited|withdrawn|withdrawal|outward|paid)\\b|\\btransfer\\b[^!?;]{0,90}\\bfrom\\s+(?:your\\s+)?account\\b|خصم|سحب|شراء|تسديد|دفع|صادرة|من\\s+حسابك\\s+[إا]لى",
    "incoming": "\\b(?:credited|refund|reversal|deposit|deposited|inward|incoming|received)\\b|[إا]يداع|استلام|استلمت|واردة|استرجاع|[إا]ضافة\\s+مبلغ",
    "directionDenied": "\\b(?:debit\\s+or\\s+credit|direction|incoming\\s+or\\s+outgoing)\\b[^.!?;]{0,50}\\b(?:unavailable|unknown|unspecified|unclear)\\b|اتجاه[^.!?;]{0,30}غير\\s+معروف",
    "transfer": "\\b(?:transfer|cliq)\\b|تحويل|حوالة|كليك",
    "own": "\\bbetween\\s+(?:your|my)(?:\\s+own)?\\s+accounts\\b|\\bown\\s+account\\s+transfer\\b|بين\\s+حسابات(?:ك|كم|ي)|من\\s+حسابك[^!?;]{0,80}[إا]لى\\s+حسابك",
    "otherPerson": "\\b(?:another\\s+person|someone\\s+else|external\\s+transfer|another\\s+customer)\\b|شخص\\s+[آا]خر|حساب\\s+مستفيد\\s+[آا]خر",
    "financial": "\\b(?:transaction|purchase|payment|transfer|debited|credited|withdrawal|deposit|refund|cashback|ATM|authorization)\\b|حركة|حوالة|تحويل|خصم|سحب|شراء|دفع|تفويض|[إا]يداع",
    "balance": "\\b(?:(?:available|current|remaining|account)\\s+)?(?:balance|bal\\.?)(?![a-z])|\\bavail\\.?\\s+bal\\b|(?:الرصيد|رصيد(?:ك|كم)?)(?:\\s+(?:المتاح|المتوفر|الحالي))?",
    "balanceJoin": "\\s*(?:is\\s*|:)?\\s*",
    "amountAnchor": "\\b(?:amount|purchase|payment|transfer|withdrawal|deposit)(?:\\s+(?:of|for))?\\s*:?\\s*|بقيمة\\s*|مبلغ\\s*|(?:تحويل|سحب|[إا]يداع)\\s+",
    "ambiguousCurrency": "\\b(?:dollars?|pounds?|riyals?)\\b",
    "fx": "\\b(?:billed|equivalent|converted)\\b|يعادل|احتساب",
    "partyReject": "^(?:(?:account|wallet|another\\s+person|another\\s+customer|complete|completing|your|restaurant\\s+meal|groceries)\\b|(?:this|that)\\s+(?:notification|message)\\b|card\\s*[*x0-9])|^(?:حساب|بطاق|محفظ|شخص\\s+[آا]خر|وجبة)|^[0-9x* .:/-]+$|^(?:ال)?(?:حساب|بطاق|محفظ)|^[A-Z]{3}\\s*[0-9]",
    "partyTrailer": "\\s+(?:completed|successfully|processed)(?:[.!])?$",
    "alignedLocation": "\\s{4,}[A-Za-z]{2}\\s*$",
    "deferred": "\\b(?:pending|requested|please\\s+(?:approve|pay|send|transfer)|scheduled|no\\s+money\\s+has\\s+moved)\\b|طلب\\s+(?:دفع|تحويل)|يرجى\\s+(?:دفع|تحويل|تسديد)|قيد\\s+المعالجة|لم\\s+تكتمل",
    "otp": "\\b(?:OTP|one[- ]time\\s+(?:password|code)|verification\\s+code)\\b|رمز\\s+(?:التحقق|الت[أا]كيد)",
    "declined": "\\b(?:declined|failed|rejected|unsuccessful|insufficient\\s+funds)\\b|تم\\s+رفض|مرفوض|عدم\\s+كفاية\\s+الرصيد|فشل(?:ت)?\\s+(?:عملية|حركة)",
    "chat": "\\bI\\s+(?:just\\s+)?(?:sent|transferred|paid|gave)\\b|\\bsent\\s+you\\b|\\bcheck\\s+your\\s+account\\b|حولتلك|بعثتلك|بعتلك|شيك\\s+عحسابك|بالله",
    "promotion": "\\b(?:earn\\s+cashback|offer|promotion|discount|maintenance|system\\s+upgrade)\\b|عرض\\s+خاص|احصل\\s+على|صيانة",
    "serviceScope": "\\b(?:services?|systems?|maintenance|upgrade)\\b|خدمة|خدمات|صيانة",
    "otpRequest": "\\b(?:use|enter|provide)\\s+(?:your\\s+)?(?:OTP|one[- ]time\\s+(?:password|code))\\b|\\bOTP\\s*[0-9]{4,8}\\s+to\\b",
    "reportedSpeech": "\\b(?:he|she|they|someone)\\s+(?:said|wrote)\\b|\\b(?:quote|example|sample|template)\\s*:|قال\\s+(?:لي|لك)|مثال\\s*:",
    "amountAlternatives": "[0-9]\\s+(?:or|أو)\\s+(?:(?:[A-Z]{3}|د\\.أ|دينار)\\s*)?[0-9]",
    "balanceInquiry": "\\bbalance\\s+(?:inquiry|enquiry)\\b|استعلام\\s+(?:عن\\s+)?الرصيد",
    "partyAnchor": "(?:\\bat|\\bfrom|\\bto|\\bmerchant(?:\\s+name)?\\s*:|\\b(?:recipient|beneficiary)\\s*:|(?<![\\u0621-\\u064A])(?:لدى|من|[إا]لى))\\s+",
    "partyValue": "^(.+?)(?=\\s+(?:completed|processed|successfully|debited|credited|available\\s+balance|current\\s+balance|بنجاح|الرصيد|رصيد)|[.;]|$)"
  },
